        <mxCell id="e_g4" style="endArrow=classic;html=1;strokeColor=#01696F;strokeWidth=3;exitX=0.5;exitY=0;entryX=0.55;entryY=1;" edge="1" parent="1" source="g4" target="sw10g"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- NAS to 10G core -->
        <mxCell id="e_nas" style="endArrow=classic;html=1;strokeColor=#01696F;strokeWidth=3;exitX=0.5;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="nas" target="sw10g"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- WGR to 10G core -->
        <mxCell id="e_wgr" style="endArrow=classic;html=1;strokeColor=#01696F;strokeWidth=3;exitX=0.3;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="wgr" target="sw10g"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- IoT/Guest/Test to hEX -->
        <mxCell id="e_iot" style="endArrow=classic;html=1;strokeColor=#964219;strokeWidth=3;exitX=0.2;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="iot" target="hex"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_guest" style="endArrow=classic;html=1;strokeColor=#7A39BB;strokeWidth=3;exitX=0.2;exitY=0;entryX=0.95;entryY=1;" edge="1" parent="1" source="guest" target="hex"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_test" style="endArrow=classic;html=1;strokeColor=#437A22;strokeWidth=3;exitX=0.1;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="test" target="hex"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- VPN bubble overlay to MHV -->
        <mxCell id="e_vpn_mhv" style="endArrow=classic;html=1;strokeColor=#1B474D;strokeWidth=2;dashed=1;dashPattern=8 4;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="vpn" target="mhv">
          <mxGeometry relative="1" as="geometry"/>
