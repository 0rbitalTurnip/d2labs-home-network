        <!-- ===================== TAILSCALE NOTE ===================== -->
        <mxCell id="tsnote" value="TAILSCALE TAILNET&#10;&#10;• Subnet router + exit node on OPNsense (advertises 10.10.0.0/16)&#10;• Native clients: MHV, Media, NAS, WGR, phones, laptop&#10;• ACLs: tag:admin → MGMT v10  |  tag:user → LAN v20 only&#10;• MagicDNS aliased to *.d2.lol via AdGuard split-horizon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D19900;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="1600" y="90" width="560" height="220" as="geometry" />
        </mxCell>

