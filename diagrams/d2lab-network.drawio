        <!-- Tailscale dashed overlay (visual layer hint) -->
        <mxCell id="e_ts_opn_mhv" style="endArrow=none;html=1;strokeColor=#D19900;strokeWidth=2;dashed=1;dashPattern=4 4;exitX=0;exitY=0.5;entryX=0.9;entryY=0;" edge="1" parent="1" source="opn" target="mhv">
          <mxGeometry relative="1" as="geometry"/>
