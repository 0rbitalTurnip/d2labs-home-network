        <mxCell id="hostt" value="OPNsense g3       v10:.1   v20:.1   v30:.1   v40:.1   v50:.1   v60:.1&#10;SG105E (mgmt)   v10:.2&#10;hEX RB750Gr3    v10:.3   (test-net router on VLAN 50)&#10;Future 10G sw    v10:.4&#10;MHV (Proxmox)   eno1 v10:.10   enp1s0f1 v20:.10   IPMI v10:.110&#10;Media Server      v20:.11   IPMI v10:.111   plex.d2.lol&#10;NUC i5                  v20:.12&#10;G4 Mini                  v20:.13&#10;i3 NAS                   v20:.20   nas.d2.lol&#10;WGR (Win Gaming)  v20:.50&#10;TV / Hue Bridge      v30:.30 / .31&#10;Guest AP SSID         v40 (DHCP pool .100-.200)&#10;Gluetun VPN-CT     v60:.60   (LXC on MHV — torrents only)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Courier New;spacingLeft=12;spacingTop=30;whiteSpace=wrap;" vertex="1" parent="1">
