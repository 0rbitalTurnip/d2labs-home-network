        <!-- ===================== OPNSENSE g3 ===================== -->
        <mxCell id="opn" value="OPNsense g3 — EDGE FW + ROUTER&#10;━━━━━━━━━━━━━━━━━━━━&#10;• igb0 WAN  (DHCP from ISP)&#10;• igb1 LAN  trunk → switch (all VLANs tagged)&#10;• Tailscale subnet router + exit node&#10;• WireGuard server (remote admin)&#10;• Suricata IDS / CrowdSec&#10;• Zenarmor + ntopng monitoring&#10;• HAProxy → *.d2.lol reverse proxy&#10;• AdGuard Home (DNS, split-horizon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01696F;strokeColor=#0C4E54;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="400" height="200" as="geometry" />
        </mxCell>

        <!-- ===================== CORE SWITCH (FUTURE 10G) ===================== -->
        <mxCell id="sw10g" value="FUTURE 10G CORE SWITCH&#10;(planned: MikroTik CRS305 / CRS309 or QNAP QSW-M2108)&#10;━━━━━━━━━━━━━━━━━━━━&#10;• 8× 10GbE SFP+/RJ45  • 802.1Q VLAN trunk&#10;• Replaces SG105E in core role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B474D;strokeColor=#0C4E54;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="760" width="800" height="100" as="geometry" />
        </mxCell>

        <!-- ===================== SG105E ===================== -->
        <mxCell id="sg" value="SG105E (current — 1GbE Easy Smart)&#10;━━━━━━━━━━━━━━━━━━━━&#10;P1 trunk → OPNsense igb1   (all VLANs tagged, 10 native)&#10;P2 trunk → MHV enp1s0f1   (10,20,30,50,60 tagged)&#10;P3 access v20 → Media Server&#10;P4 access v20 → NAS / NUC / G4 (via hEX downstream)&#10;P5 trunk → hEX RB750Gr3   (carries IoT v30 + Guest v40 + Test v50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#20808D;strokeColor=#1B474D;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
