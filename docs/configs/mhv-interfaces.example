auto lo
iface lo inet loopback

# 1G management on eno1 (untagged v10)
auto eno1
iface eno1 inet manual

auto vmbr10
iface vmbr10 inet static
    address 10.10.10.10/24
    gateway 10.10.10.1
    bridge-ports eno1
    bridge-stp off
    bridge-fd 0

# 10G WAN failover / direct test (manual; bridge only when needed)
auto enp1s0f0
iface enp1s0f0 inet manual

# 10G LAN trunk
auto enp1s0f1
iface enp1s0f1 inet manual

# VLAN 20 — LAN/servers
auto enp1s0f1.20
iface enp1s0f1.20 inet manual
auto vmbr20
iface vmbr20 inet static
    address 10.10.20.10/24
    bridge-ports enp1s0f1.20
    bridge-stp off
    bridge-fd 0

# VLAN 30 — IoT (no host IP; bridge only)
auto enp1s0f1.30
iface enp1s0f1.30 inet manual
auto vmbr30
iface vmbr30 inet manual
    bridge-ports enp1s0f1.30
    bridge-stp off
    bridge-fd 0

# VLAN 50 — TEST sandbox
auto enp1s0f1.50
iface enp1s0f1.50 inet manual
auto vmbr50
iface vmbr50 inet manual
    bridge-ports enp1s0f1.50
    bridge-stp off
    bridge-fd 0

# VLAN 60 — VPN-only (Gluetun lives here)
auto enp1s0f1.60
iface enp1s0f1.60 inet manual
auto vmbr60
iface vmbr60 inet manual
    bridge-ports enp1s0f1.60
    bridge-stp off
    bridge-fd 0
